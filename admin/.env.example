# Database connection (same as main backend)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/classmate_central

# Main API URL (internal docker network)
MAIN_API_URL=http://backend:8080

# Admin credentials
ADMIN_USERNAME=superadmin
# Generate hash: curl -X POST http://localhost:4000/api/auth/generate-hash -H "Content-Type: application/json" -d '{"password":"your-secure-password"}'
ADMIN_PASSWORD_HASH=

# JWT Configuration
ADMIN_JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_JWT_EXPIRES_IN=24h

# CORS origin (admin frontend URL)
CORS_ORIGIN=http://localhost:5174
