# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/classmate_central

# Main API URL
MAIN_API_URL=http://localhost:8080

# Admin credentials
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD_HASH=$2a$10$... # bcrypt hash of your password

# JWT Configuration
ADMIN_JWT_SECRET=your-super-secret-jwt-key-for-admin
ADMIN_JWT_EXPIRES_IN=24h

# Server
PORT=4000
NODE_ENV=development
