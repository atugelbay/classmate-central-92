# Database Configuration
DB_HOST=localhost                    # Database host
DB_PORT=5432                         # Database port
DB_USER=postgres                     # Database user
DB_PASSWORD=postgres                 # Database password (CHANGE IN PRODUCTION!)
DB_NAME=classmate_central            # Database name
DB_SSLMODE=disable                   # SSL mode: disable, require, verify-ca, verify-full

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production  # Secret key for JWT tokens (MUST CHANGE IN PRODUCTION!)
JWT_EXPIRATION=24h                   # Access token expiration (e.g., 24h, 1h)
JWT_REFRESH_EXPIRATION=168h          # Refresh token expiration (e.g., 168h = 7 days)

# Server Configuration
SERVER_PORT=8080                     # Server port
SERVER_HOST=0.0.0.0                  # Server host (0.0.0.0 for all interfaces)

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173   # Frontend application URL

# CORS Configuration (Production)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com  # Comma-separated list of allowed origins

# Email Configuration (choose one method)

# Option 1: Resend API (RECOMMENDED for Railway - works via HTTPS, not blocked)
RESEND_API_KEY=re_xxxxxxxxxxxxx      # Resend API key (get from https://resend.com)
SMTP_FROM_EMAIL=your-email@domain.com # From email (must be verified in Resend)

# Option 2: SMTP (Gmail: если 587 не подключается — попробуйте 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465                        # 465 = SSL (часто не блокируется), 587 = STARTTLS
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password      # Пароль приложения из аккаунта Google
# SMTP_FROM_EMAIL=your-email@gmail.com

# Environment
ENV=production                       # Environment: development, production, test

